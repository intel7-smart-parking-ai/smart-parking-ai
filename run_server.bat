@echo off
chcp 65001 > nul
echo ====================================================================
echo [AI 스마트 주차장] 요금·모의결제·매출 로컬 서버를 시작합니다...
echo.
echo • 기본 포트: 8080 (8000번 대신 충돌 없는 8080 기본 사용)
echo • 다른 포트로 실행하려면: run_server.bat 8081  (뒤에 원하는 포트 번호 입력)
echo • 포트가 이미 사용 중인 경우 자동으로 다음 빈 포트를 찾아 연결합니다.
echo ====================================================================

set PORT_ARG=%1
if "%PORT_ARG%"=="" (
    python server.py --port 8080
) else (
    python server.py --port %PORT_ARG%
)

pause
