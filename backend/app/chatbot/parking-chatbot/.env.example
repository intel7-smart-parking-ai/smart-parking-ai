# 데이터: mock(가짜) / api(팀 백엔드)
DATA_SOURCE=mock
BACKEND_BASE_URL=http://127.0.0.1:8000

# LLM 분류기: none / anthropic / openai / openrouter  (none이면 규칙 파서만 사용)
# 기본: OpenRouter + Claude Haiku 5.5. 키가 비어 있으면 자동으로 규칙 파서만 사용(오류 없음).
# 사용 전 1회: python -m pip install -r requirements-llm.txt
LLM_ENGINE=langchain
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-haiku-5.5
# Gemma로 바꾸려면 위 줄을 → LLM_MODEL=google/gemma-4-26b-a4b-it
LLM_TIMEOUT_SEC=3
# ▼ API 키: 이 파일을 .env로 복사한 뒤, 아래 줄의 '# '를 지우고 = 뒤에 키를 붙여 넣으세요. (.env는 Git에 올라가지 않음, 키 커밋 금지)
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 목업 요금 기본값 (팀 billing 계산기 기준). 주차장별 값은 chatbot/lots.json의 rate_policy가 우선
BASE_MINUTES=30
BASE_FEE=1000
UNIT_MINUTES=10
UNIT_FEE=500
DAILY_CAP=10000

# 팀 백엔드 인증·시간 제한 (LLM API 키와 별개)
BACKEND_TOKEN=
BACKEND_TIMEOUT_SEC=2
CACHE_MAX_STALE_SEC=30
DATA_MAX_AGE_SEC=30
# 목업 요금 견적 유효 시간(초). API 모드는 서버 quote_expires_at을 따른다
MOCK_QUOTE_TTL_SEC=300
SESSION_IDLE_SEC=7200
MAX_SESSIONS=200

# 안정화 설정: 사용자 화면 8초 제한보다 짧은 외부 조회 예산
REQUEST_BUDGET_SEC=6
# API 모드에서 경보 공용 조회 최대 공유 시간 (초); mock은 동시 요청만 공유
ALERT_SHARE_SEC=0.2
# 공유망/팀 서버에서 관리자·시연 API에 필요한 별도 접근 키 (백엔드 키와 별개)
ADMIN_TOKEN=
# 실제 API 모드에서는 기본 비활성. 시연 경보·출차·reset 허용 시에만 1
# DEMO_ENABLED=1
# dev 서버는 기본 로컬 전용. 사용자 화면을 같은 와이파이에 열 때만 0.0.0.0
HOST=127.0.0.1

# 같은 세션·차량·사건의 관리자 호출을 하나로 합치는 시간(초). 상태 추적이 꺼져 있을 때 사용
CALL_MERGE_SEC=600

# 선택 설치: pip install -r requirements-llm.txt
# 모델: 기본 anthropic/claude-haiku-5.5 (KAN-51 실측 83%, D-44 제안) / 기존 D-18 google/gemma-4-26b-a4b-it
# LLM 끄기: LLM_PROVIDER=none
# 다른 제공자: LLM_PROVIDER=anthropic 또는 openai + ANTHROPIC_API_KEY 또는 OPENAI_API_KEY
# 되돌리기: LLM_ENGINE=direct (기존 직접 호출 분류기)

# 팀 모드 동시 처리 및 기록 보존 (선택 설정)
# CHAT_MAX_CONCURRENT=4
# ADMIN_CALL_LIMIT=500
# INCIDENT_LIMIT=100
# UNCERTAIN_PAYMENT_LIMIT=1000

# 팀 API 그룹별 장애 차단
# BACKEND_BREAKER_FAILS=3
# BACKEND_BREAKER_OPEN_SEC=10

# 세션·전체 분당 및 KST 일간 LLM 호출 수
# LLM_MAX_PER_SESSION_MIN=5
# LLM_MAX_PER_MIN=30
# LLM_MAX_PER_DAY=1000
# LLM_ROUTE_CACHE_SEC=600

# LLM 분류 예시 3쌍 (기본 꺼짐, 사람이 비교 측정한 뒤 1로 켬)
# LLM_FEWSHOT=0
# 첫 미인식 응답의 기존 칩 정렬 (기본 꺼짐)
# FALLBACK_HINTS=0
