# 데이터: mock(가짜) / api(팀 백엔드)
DATA_SOURCE=mock
BACKEND_BASE_URL=http://127.0.0.1:8000

# LLM 분류기: none / anthropic / openai  (none이면 규칙 파서만 사용)
LLM_PROVIDER=none
LLM_MODEL=
LLM_TIMEOUT_SEC=3
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 임시 요금 규칙 (EPIC 05 확정 전)
FREE_MINUTES=30
FEE_UNIT_MINUTES=10
FEE_PER_UNIT=500

# 팀 백엔드 인증·시간 제한 (LLM API 키와 별개)
BACKEND_TOKEN=
BACKEND_TIMEOUT_SEC=2
CACHE_MAX_STALE_SEC=30
DATA_MAX_AGE_SEC=30
SESSION_IDLE_SEC=7200
MAX_SESSIONS=200

# 안정화 설정: 사용자 화면 8초 제한보다 짧은 외부 조회 예산
REQUEST_BUDGET_SEC=6
# API 모드에서 경보 공용 조회 최대 공유 시간 (초); mock은 동시 요청만 공유
ALERT_SHARE_SEC=0.2
# 공유망/팀 서버에서 관리자·시연 API에 필요한 별도 접근 키 (백엔드 키와 별개)
ADMIN_TOKEN=
# 실제 API 모드에서는 기본 비활성. 시연 경보·출차·reset 허용 시에만 1
# DEMO_ENABLED=1
# dev 서버는 기본 로컬 전용. 사용자 화면을 같은 와이파이에 열 때만 0.0.0.0
HOST=127.0.0.1

# 같은 세션·차량·사건의 관리자 호출을 하나로 합치는 시간(초). 상태 추적이 꺼져 있을 때 사용
CALL_MERGE_SEC=600
