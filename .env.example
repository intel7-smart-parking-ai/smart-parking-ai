# .env에 실제 값을 입력하고 절대 Git에 업로드하지 마세요.
APP_ENV=development
DATABASE_URL=sqlite:///./parking.db
# 사용 중인 LLM 제공자에 해당하는 항목만 사용
LLM_API_KEY=
# 실제 카메라 장치 번호와 ROI는 별도 configs 설정 파일로 관리

# Local Docker demo only. scripts/start.ps1 generates .env when missing.
POSTGRES_PASSWORD=replace_with_a_random_local_password
