# .env에 실제 값을 입력하고 절대 Git에 업로드하지 마세요.
APP_ENV=development
DATABASE_URL=sqlite:///./parking.db
# 챗봇 LLM (DECISIONS D-18: OpenRouter). 챗봇은 backend/app/chatbot/parking-chatbot/.env 에서 읽는다
OPENROUTER_API_KEY=
# 실제 카메라 장치 번호와 ROI는 별도 configs 설정 파일로 관리

# D-20/D-25/D-28/D-38: final single-api Docker deployment
PARKING_MODE=demo
# Required: generate an ASCII random token of at least 16 characters in your private .env.
VISION_TOKEN=
ALERTS_INTERNAL_TOKEN=
SMART_PARKING_DB_PATH=data/smart_parking.db
FEE_QUOTE_TTL_SECONDS=300
# Existing administrator htpasswd file; never commit its contents.
ADMIN_HTPASSWD_PATH=./.local-access/htpasswd
# 0.0.0.0 permits a separate camera PC to use port 80; use 127.0.0.1 for loopback-only runs.
WEB_BIND_ADDRESS=0.0.0.0
LLM_PROVIDER=none
LLM_MODEL=google/gemma-4-26b-a4b-it

# Production: same api container. Rehearsal gateway only: host.docker.internal:8002
API_UPSTREAM=api:8000
